# =============================================================================
# SomPrev Risk - variaveis de ambiente (copie para .env e preencha)
# O jeito mais facil e seguro: python run.py configurar   (gera tudo com segredos fortes)
# NUNCA versione o arquivo .env.
# =============================================================================

# Chaves da API com escopos separados (privilegio minimo)
# ingestao: POST /telemetria (coletores de campo)
SOMPREV_API_KEY=
# consulta: GET /leituras, /alertas, /relatorios... (BI / seguradora)
SOMPREV_API_KEY_CONSULTA=

# Usuarios iniciais do dashboard (senha: 12+ caracteres com letras e numeros).
# O pipeline grava no banco SOMENTE o hash PBKDF2 destas senhas.
SOMPREV_OPERADOR_USER=
SOMPREV_OPERADOR_PASSWORD=
SOMPREV_TECNICO_USER=
SOMPREV_TECNICO_PASSWORD=
SOMPREV_GESTOR_USER=
SOMPREV_GESTOR_PASSWORD=
SOMPREV_SEGURADORA_USER=
SOMPREV_SEGURADORA_PASSWORD=

# Opcionais (valores padrao entre parenteses)
# requisicoes por minuto por chave/IP:   SOMPREV_API_LIMITE_REQ_MINUTO=600
# tentativas de login antes do bloqueio: SOMPREV_LOGIN_MAX_TENTATIVAS=5
# minutos de bloqueio:                   SOMPREV_LOGIN_BLOQUEIO_MINUTOS=15
# reprodutibilidade (dados e modelo):    SOMPREV_SEED=42
